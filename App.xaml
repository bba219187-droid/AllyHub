<Application x:Class="AllyHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Color x:Key="Accent">#FF1F3D</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF1F3D"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8A90A0"/>
    <SolidColorBrush x:Key="CardBrush" Color="#D9101117"/>
    <FontFamily x:Key="Display">Bahnschrift, Segoe UI</FontFamily>

    <!-- Emblema original da AllyHub: hexagono + "A" angular -->
    <PathGeometry x:Key="EmblemHex" Figures="M 50,4 L 92,28 L 92,72 L 50,96 L 8,72 L 8,28 Z"/>
    <PathGeometry x:Key="EmblemA" Figures="M 28,74 L 50,26 L 72,74 M 37,58 L 63,58"/>

    <!-- riscas diagonais de fundo -->
    <DrawingBrush x:Key="Stripes" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen><Pen Brush="White" Thickness="1"/></GeometryDrawing.Pen>
          <GeometryDrawing.Geometry><LineGeometry StartPoint="0,16" EndPoint="16,0"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- botoes "chip" inclinados -->
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="#1C1E27" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="14,7">
              <Border.RenderTransform><SkewTransform AngleX="-12"/></Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#FF1F3D"/>
              </Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="b" Property="Background" Value="#FF1F3D"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#FF1F3D"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- capas dos jogos: crescem e brilham quando estao selecionadas -->
    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Width" Value="190"/>
      <Setter Property="Height" Value="285"/>
      <Setter Property="Margin" Value="16,24"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Border x:Name="frame" Background="#1A1C24" BorderBrush="#22FFFFFF" BorderThickness="2" CornerRadius="6">
                <Border.Effect><DropShadowEffect x:Name="glow" Color="#FF1F3D" BlurRadius="0" ShadowDepth="0" Opacity="0"/></Border.Effect>
                <Grid ClipToBounds="True"><ContentPresenter/></Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="frame" Property="BorderBrush" Value="#FF1F3D"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="40" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- legenda dos botoes do comando -->
    <Style x:Key="Key" TargetType="Border">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Background" Value="#262833"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
  </Application.Resources>
</Application>
