<Window x:Class="AllyHub.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="icon.ico" Title="AllyHub — Modo de testes" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="#0A0B0F" Foreground="White" FontFamily="{StaticResource Display}">
  <Grid>
    <Rectangle Fill="{StaticResource Stripes}" Opacity="0.035" IsHitTestVisible="False"/>
    <DockPanel Margin="70,44">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="MODO DE TESTES" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
        <TextBlock x:Name="Header" FontSize="44" FontWeight="Bold" Margin="0,4,0,2"/>
        <TextBlock x:Name="Sub" FontSize="17" Foreground="#9AA0AE" TextWrapping="Wrap" Margin="0,0,0,24"/>
      </StackPanel>
      <TextBlock x:Name="Hint" DockPanel.Dock="Bottom" FontSize="14" Foreground="#5E6472" Margin="0,16,0,0"/>
      <Grid x:Name="Area"/>
    </DockPanel>
    <!-- ecra inteiro: cores e toque -->
    <Grid x:Name="Full" Visibility="Collapsed" Background="Black">
      <Canvas x:Name="Paint" Background="Transparent"/>
      <TextBlock x:Name="FullHint" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30" FontSize="16" Foreground="#80FFFFFF"/>
    </Grid>
  </Grid>
</Window>
