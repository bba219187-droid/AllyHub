<Window x:Class="AllyHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AllyHub" WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize"
        Background="#0A0B0F" Foreground="White" FontFamily="{StaticResource Display}">
  <Grid>
    <!-- ===== fundo: arte do jogo selecionado, desfocada ===== -->
    <Image x:Name="HeroBg" Stretch="UniformToFill" Opacity="0">
      <Image.Effect><BlurEffect Radius="28"/></Image.Effect>
    </Image>
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#D00A0B0F" Offset="0"/>
          <GradientStop Color="#550A0B0F" Offset="0.4"/>
          <GradientStop Color="#F20A0B0F" Offset="0.78"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#E00A0B0F" Offset="0"/>
          <GradientStop Color="#000A0B0F" Offset="0.6"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle Fill="{StaticResource Stripes}" Opacity="0.035" IsHitTestVisible="False"/>
    <Ellipse Width="1000" Height="1000" HorizontalAlignment="Left" VerticalAlignment="Bottom"
             Margin="-500,0,0,-560" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#45FF1F3D" Offset="0"/>
          <GradientStop Color="#00FF1F3D" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <Grid Margin="44,26,44,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ===== barra de cima ===== -->
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button x:Name="AutoBtn" Style="{StaticResource Chip}" Click="AutoStart_Click" Margin="0,0,14,0"/>
          <TextBlock x:Name="BatteryText" FontSize="18" VerticalAlignment="Center" Margin="0,0,20,0"/>
          <TextBlock x:Name="Clock" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
          <Button Content="✕" Style="{StaticResource Chip}" Click="Exit_Click" Margin="0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Viewbox Width="38" Height="38">
            <Canvas Width="100" Height="100">
              <Canvas.Effect><DropShadowEffect Color="#FF1F3D" BlurRadius="14" ShadowDepth="0"/></Canvas.Effect>
              <Path Data="{StaticResource EmblemHex}" Stroke="#FF1F3D" StrokeThickness="6"/>
              <Path Data="{StaticResource EmblemA}" Stroke="White" StrokeThickness="9" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
            </Canvas>
          </Viewbox>
          <TextBlock Text="ALLYHUB" FontSize="26" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="Status" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="22,4,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>

      <!-- ===== centro: jogo selecionado + painel de desempenho ===== -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="Info" VerticalAlignment="Bottom" Margin="0,0,40,0">
          <Border Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Padding="12,3">
            <Border.RenderTransform><SkewTransform AngleX="-12"/></Border.RenderTransform>
            <TextBlock x:Name="StoreText" FontSize="14" FontWeight="Bold"/>
          </Border>
          <TextBlock x:Name="GameTitle" FontSize="58" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,4">
            <TextBlock.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.8"/></TextBlock.Effect>
          </TextBlock>
          <TextBlock x:Name="GameInfo" FontSize="18" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <!-- cartao de desempenho -->
        <Border Grid.Column="1" VerticalAlignment="Center" Background="{StaticResource CardBrush}"
                BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="4" Padding="26,22">
          <StackPanel>
            <DockPanel>
              <TextBlock x:Name="ProfileName" DockPanel.Dock="Right" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
              <TextBlock Text="DESEMPENHO" FontSize="14" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>

            <Grid Width="220" Height="220" Margin="0,12,0,6">
              <Path x:Name="GaugeTrack" Stroke="#22FFFFFF" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path x:Name="GaugeArc" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Stroke>
                  <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Color="#FF8A1F" Offset="0"/>
                    <GradientStop Color="#FF1F3D" Offset="1"/>
                  </LinearGradientBrush>
                </Path.Stroke>
                <Path.Effect><DropShadowEffect Color="#FF1F3D" BlurRadius="22" ShadowDepth="0"/></Path.Effect>
              </Path>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="WattsBig" FontSize="72" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="WATTS" FontSize="14" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,-8,0,0"/>
              </StackPanel>
            </Grid>

            <WrapPanel x:Name="ProfileBar" HorizontalAlignment="Center" Margin="0,6,0,4"/>
            <Slider x:Name="WattSlider" Focusable="False" IsSnapToTickEnabled="True" TickFrequency="1"
                    Margin="0,6,0,0" ValueChanged="Slider_Changed"/>
            <TextBlock x:Name="TdpState" FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ===== carrossel de jogos ===== -->
      <ScrollViewer x:Name="Scroll" Grid.Row="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    Focusable="False" Margin="-16,8,-16,0" PanningMode="HorizontalOnly">
        <StackPanel x:Name="Tiles" Orientation="Horizontal"/>
      </ScrollViewer>

      <!-- ===== legenda do comando ===== -->
      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0" TextElement.FontSize="15" TextElement.Foreground="#9AA0AE">
        <Border Style="{StaticResource Key}"><TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#5BD75B" FontWeight="Bold"/></Border>
        <TextBlock Text="Jogar" VerticalAlignment="Center" Margin="0,0,22,0"/>
        <Border Style="{StaticResource Key}" Width="40"><TextBlock Text="LB RB" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
        <TextBlock Text="Perfil" VerticalAlignment="Center" Margin="0,0,22,0"/>
        <Border Style="{StaticResource Key}"><TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4FA3FF" FontWeight="Bold"/></Border>
        <Border Style="{StaticResource Key}"><TextBlock Text="Y" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFC83D" FontWeight="Bold"/></Border>
        <TextBlock Text="−/+ 1 W" VerticalAlignment="Center" Margin="0,0,22,0"/>
        <Border Style="{StaticResource Key}"><TextBlock Text="B" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF5C5C" FontWeight="Bold"/></Border>
        <TextBlock Text="Atualizar lista" VerticalAlignment="Center" Margin="0,0,22,0"/>
        <TextBlock Text="•  Ecrã: toca para escolher, toca outra vez para jogar" VerticalAlignment="Center" Foreground="#5E6472"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
