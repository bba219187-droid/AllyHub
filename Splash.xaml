<Window x:Class="AllyHub.Splash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="icon.ico" Title="AllyHub" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        WindowState="Maximized" Background="#07080B" Topmost="True" Opacity="0"
        Foreground="White" FontFamily="{StaticResource Display}">
  <Grid>
    <Rectangle Fill="{StaticResource Stripes}" Opacity="0.04"/>
    <Ellipse x:Name="Pulse" Width="700" Height="700" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
      <Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale"/></Ellipse.RenderTransform>
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#40FF1F3D" Offset="0"/>
          <GradientStop Color="#00FF1F3D" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
      <Grid Width="170" Height="170" HorizontalAlignment="Center">
        <!-- se existir splash.png ao lado do .exe, aparece em vez do emblema -->
        <Image x:Name="Custom" Visibility="Collapsed" Stretch="Uniform"/>
        <Viewbox x:Name="Emblem">
          <Canvas Width="100" Height="100">
            <Canvas.Effect><DropShadowEffect Color="{DynamicResource Accent}" BlurRadius="30" ShadowDepth="0" Opacity="1"/></Canvas.Effect>
            <Path x:Name="Hex" Data="{StaticResource EmblemHex}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="4"
                  StrokeLineJoin="Miter" StrokeDashArray="80 80" StrokeDashOffset="80"/>
            <Path x:Name="Letter" Data="{StaticResource EmblemA}" Stroke="White" StrokeThickness="7"
                  StrokeLineJoin="Miter" StrokeStartLineCap="Square" StrokeEndLineCap="Square" Opacity="0"/>
          </Canvas>
        </Viewbox>
      </Grid>
      <TextBlock x:Name="Brand" Text="ALLYHUB" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,24,0,0" Opacity="0"/>
      <TextBlock x:Name="Msg" Text="A iniciar…" FontSize="16" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,24"/>
      <Border Width="340" Height="4" Background="#1FFFFFFF" ClipToBounds="True">
        <Rectangle Width="120" HorizontalAlignment="Left" Fill="{DynamicResource AccentBrush}">
          <Rectangle.RenderTransform><TranslateTransform x:Name="BarX"/></Rectangle.RenderTransform>
        </Rectangle>
      </Border>
    </StackPanel>

    <TextBlock x:Name="Ver" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="32" Foreground="#4A4F5C" FontSize="14"/>
  </Grid>
</Window>
